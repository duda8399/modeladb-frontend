{
  "name": "modeladb-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:sql-engines": "SQL_ENGINES=1 vitest run src/utils/sqlExport.engines.test.ts",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test:e2e": "playwright test --project chrome",
    "test:e2e:ui": "playwright test --project chrome --ui",
    "bench": "vitest bench --run --outputJson reports/perf/store-bench.json",
    "test:e2e:perf": "playwright test --project perf"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@reactflow/node-resizer": "^2.2.14",
    "@uiw/react-codemirror": "^4.25.10",
    "antd": "^5.25.1",
    "axios": "^1.13.4",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.574.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.6.0",
    "react-router-dom": "^6.30.0",
    "reactflow": "^11.11.4",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fast-check": "^4.10.2",
    "globals": "^16.5.0",
    "node-sql-parser": "^5.4.0",
    "pg-mem": "^3.0.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.11"
  }
}
